# PC Bottleneck Analyzer - Environment Variables
# Copy this file to .env.local and fill in values

# AI analysis runs through claudex (Max-sub `claude -p` subprocess) — no API key.
# Make sure the `claude` CLI is installed and signed in on the host.

# Lemon Squeezy (Pro payments)
# Get your checkout URL from: app.lemonsqueezy.com > Store > Products > [your product] > Share
# (the production PCopti Tool URL is baked into src/lib/pro.ts as the default)
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=
# Get your webhook secret from: app.lemonsqueezy.com > Settings > Webhooks
# Point the webhook at https://pcbottleneck.buildkit.store/api/webhook/lemonsqueezy
# (order_created events become purchase rows in analytics). The webhook
# rejects everything until this is set.
LEMONSQUEEZY_WEBHOOK_SECRET=

# Pro paywall master switch (build-time). Unset = everything free (beta).
# Set to "true" in Vercel + redeploy to arm the $9.99 Pro gate.
NEXT_PUBLIC_GATES_ENABLED=

# Show the AI Insights tab (build-time). Only works where the `claude` CLI
# exists (local dev) — leave unset on Vercel so the tab stays hidden.
NEXT_PUBLIC_AI_ENABLED=
